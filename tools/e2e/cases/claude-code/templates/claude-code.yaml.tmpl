schema: confidential-agent/v1

service:
  id: claude-code
  ports: []
  connect: []

build:
{{raw:BASE_IMAGE_LINE}}
  image_name: claude-code-agent
  resize: 30G
  with_network: true
  packages: [ca-certificates, curl, git, jq, nodejs, npm, tar, xz]
  files:
    - source: {{yaml:CAI_PEP}}
      target: /usr/local/bin/cai-pep
      executable: true
    - source: ./files/install-cli-agent-runtime.sh
      target: /usr/local/libexec/confidential-agent/cli-agent/install-cli-agent-runtime.sh
      executable: true
    - source: ./files/tdx-remote-attestation.SKILL.md
      target: /root/.claude/skills/tdx-remote-attestation/SKILL.md
  scripts: [./install-claude-code.sh]
  variants:
    release:
      enabled: false
    debug:
      enabled: true

deploy:
  provider: aliyun
  image_variant: debug
  instance_type: {{yaml:INSTANCE_TYPE}}
  region: {{yaml:REGION}}
  zone_id: {{yaml:ZONE_ID}}
  disk_gb: {{raw:DISK_GB}}

attestation:
  tee: tdx
  mode: challenge
  reference_values: {{yaml:REFERENCE_VALUES}}
{{raw:REKOR_BLOCK}}

resources:
  claude_settings:
    source: ./secrets/settings.json
    target: /root/.claude/settings.json
    mode: "0600"
    required: true
  claude_onboarding:
    source: ./secrets/claude.json
    target: /root/.claude.json
    mode: "0600"
    required: true
