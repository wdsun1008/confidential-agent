schema: confidential-agent/v1

service:
  id: hermes-agent
  ports: [8642]
  connect: [8642]
  app_service: shelter-container-hermes-agent.service

build:
{{raw:BASE_IMAGE_LINE}}
  image_name: hermes-agent
  resize: 30G
  with_network: true
  container:
    image: {{yaml:HERMES_IMAGE}}
    mode: runtime
    runtime: {{yaml:HERMES_CONTAINER_RUNTIME}}
    name: hermes-agent
    pull: missing
    command:
      - gateway
      - run
    env:
      API_SERVER_ENABLED: "true"
      API_SERVER_HOST: 0.0.0.0
      API_SERVER_PORT: "8642"
      DASHSCOPE_BASE_URL: {{yaml:DASHSCOPE_BASE_URL}}
      HERMES_HOME: /opt/data
      HERMES_MODEL: {{yaml:HERMES_MODEL}}
    working_dir: /opt/hermes
    network: true
    mounts:
      - source: /var/lib/confidential-agent/hermes-agent/data
        target: /opt/data
        read_only: false
  packages: [ca-certificates, curl, jq]
  variants:
    release:
      enabled: false
    debug:
      enabled: true

deploy:
  provider: aliyun
  image_variant: debug
  instance_type: {{yaml:INSTANCE_TYPE}}
  region: {{yaml:REGION}}
  zone_id: {{yaml:ZONE_ID}}
  disk_gb: {{raw:DISK_GB}}

attestation:
  tee: tdx
  mode: challenge
  reference_values: {{yaml:REFERENCE_VALUES}}
{{raw:REKOR_BLOCK}}

resources:
  hermes_env:
    source: ./secrets/hermes.env
    target: /var/lib/confidential-agent/hermes-agent/data/.env
    owner: "10000"
    group: "10000"
    mode: "0600"
  hermes_config:
    source: ./secrets/config.yaml
    target: /var/lib/confidential-agent/hermes-agent/data/config.yaml
    owner: "10000"
    group: "10000"
    mode: "0600"
    mutable: true
