        "python3.11",
        "tools/e2e/inference_case.py"
      ],
      "depends": [
        "publish-reuse-images"
      ],
      "environment": {
        "E2E_REPLICAS": "1",
        "E2E_SLB_TYPE": "nlb",
        "E2E_CONNECT_ENCRYPTION": "ohttp",
        "E2E_ATTESTATION_MODE": "challenge",
