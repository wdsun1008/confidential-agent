    {
      "id": "publish-reuse-images",
      "groups": [
        "reuse",
        "inference"
      ],
      "pool": "cpu",
      "command": [
        "python3.11",
        "tools/e2e/publish_fixtures.py"
      ],
      "timeout": 28800,
      "retains_fixtures": true
    },
    {
      "id": "allinone-challenge",
      "groups": [
        "reuse"
      ],
      "depends": [
        "publish-reuse-images"
      ],
      "command": [
        "python3.11",
        "tools/e2e/reuse_case.py"
      ],
      "environment": {
        "E2E_ATTESTATION_MODE": "challenge"
      },
      "timeout": 21600
    },
